---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "ses · open source voiceover pipeline",
  description =
    "ses turns a voice sample and a Markdown script into quality checked narration. A local Python pipeline that renders one WAV per section plus a full render.",
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23181818'/%3E%3Cg fill='%23e9a94b'%3E%3Crect x='6' y='13' width='3' height='6' rx='1.5'/%3E%3Crect x='11' y='9' width='3' height='14' rx='1.5'/%3E%3Crect x='16' y='11' width='3' height='10' rx='1.5'/%3E%3Crect x='21' y='14' width='3' height='4' rx='1.5'/%3E%3C/g%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ses.apphane.dev" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#181818" />
    <link rel="icon" href={favicon} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      // Scroll reveals: heavy fade up, one observer, unobserve after firing.
      const revealables = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      revealables.forEach((el) => io.observe(el));

      // Tagline reveal: words activate one at a time once the block is in view.
      const tagline = document.querySelector("[data-tagline]");
      if (tagline) {
        const to = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                tagline.classList.add("play");
                to.disconnect();
              }
            }
          },
          { threshold: 0.5 }
        );
        to.observe(tagline);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Backgrounds: allowed dark set only */
    --bg: #181818;
    --surface: #1f1f1f;
    --surface-2: #272727;
    --raised: #313131;

    --line: rgba(255, 255, 255, 0.1);
    --line-soft: rgba(255, 255, 255, 0.06);
    --ink: #f5f5f5;
    --muted: #9b9b9b;
    --dim: #737373;

    /* Accents (text, borders, fills — never backgrounds) */
    --brass: #e9a94b;
    --cyan: #63d3c7;
    --coral: #e8705e;

    /* One typeface + mono for code and data */
    --font-body: "Geist", system-ui, sans-serif;
    --font-mono: "Geist Mono", ui-monospace, monospace;

    /* Motion */
    --ease: cubic-bezier(0.32, 0.72, 0, 1);

    --maxw: 1240px;
    --maxw-wide: 1380px;
    --gutter: 24px;
    --radius: 16px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  section {
    position: relative;
  }

  section[id] {
    scroll-margin-top: 96px;
  }

  ::selection {
    background: var(--brass);
    color: #181818;
  }

  :focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .wrap {
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .wrap.wide {
    max-width: var(--maxw-wide);
  }

  .skip {
    position: absolute;
    top: -48px;
    left: 0;
    background: var(--brass);
    color: #181818;
    padding: 8px 16px;
    text-decoration: none;
    z-index: 50;
  }

  .skip:focus {
    top: 0;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--brass);
    opacity: 0.6;
  }

  .section-pad {
    padding-block: 96px;
  }
  @media (max-width: 900px) {
    .section-pad {
      padding-block: 64px;
    }
  }
  @media (max-width: 560px) {
    .section-pad {
      padding-block: 48px;
    }
  }

  /* Scroll reveal: translate + blur + fade over 800ms on the shared curve */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal] {
      opacity: 0;
      transform: translateY(64px);
      filter: blur(12px);
      transition:
        opacity 800ms var(--ease),
        transform 800ms var(--ease),
        filter 800ms var(--ease);
    }
    .js [data-reveal].revealed {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
