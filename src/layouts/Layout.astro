---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "ses · open source voiceover pipeline",
  description =
    "ses turns a voice sample and a Markdown script into quality checked narration. A local Python pipeline that renders one WAV per section plus a full render.",
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ses.apphane.dev" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content="https://ses.apphane.dev/brand/social.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ses. Your script, in a cloned voice." />
    <meta name="theme-color" content="#16100d" />
    <link rel="icon" href="/brand/icon.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="stylesheet" href="/brand/tokens.css" />
    <link rel="preload" href="/brand/fonts/InstrumentSerif-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      // Scroll reveals: heavy fade up, one observer, unobserve after firing.
      const revealables = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      revealables.forEach((el) => io.observe(el));

      // Tagline reveal: words activate one at a time once the block is in view.
      const tagline = document.querySelector("[data-tagline]");
      if (tagline) {
        const to = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                tagline.classList.add("play");
                to.disconnect();
              }
            }
          },
          { threshold: 0.5 }
        );
        to.observe(tagline);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: var(--ses-background);
    --surface: var(--ses-panel);
    --surface-2: color-mix(in srgb, var(--ses-panel) 80%, var(--ses-line));
    --raised: var(--ses-line);
    --line: var(--ses-line);
    --line-soft: color-mix(in srgb, var(--ses-line) 60%, transparent);
    --ink: var(--ses-cream);
    --muted: var(--ses-muted);
    --dim: var(--ses-muted);
    --brass: var(--ses-ember);
    --cyan: var(--ses-cream);
    --coral: var(--ses-ember);
    --font-display: var(--ses-display);
    --font-body: var(--ses-mono);
    --font-mono: var(--ses-mono);

    /* Motion */
    --ease: cubic-bezier(0.32, 0.72, 0, 1);

    --maxw: 1240px;
    --maxw-wide: 1380px;
    --gutter: 24px;
    --radius: 16px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }

  a {
    color: inherit;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  p {
    margin: 0;
    text-wrap: pretty;
  }

  section {
    position: relative;
  }

  section[id] {
    scroll-margin-top: 96px;
  }

  ::selection {
    background: var(--brass);
    color: var(--ses-background);
  }

  :focus-visible {
    outline: 2px solid var(--brass);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .wrap {
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .wrap.wide {
    max-width: var(--maxw-wide);
  }

  .skip {
    position: absolute;
    top: -48px;
    left: 0;
    background: var(--brass);
    color: var(--ses-background);
    padding: 8px 16px;
    text-decoration: none;
    z-index: 50;
  }

  .skip:focus {
    top: 0;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brass);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--brass);
    opacity: 0.6;
  }

  .section-pad {
    padding-block: 96px;
  }
  @media (max-width: 900px) {
    .section-pad {
      padding-block: 64px;
    }
  }
  @media (max-width: 560px) {
    .section-pad {
      padding-block: 48px;
    }
  }

  /* Short scroll reveals, disabled for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 500ms var(--ease),
        transform 500ms var(--ease);
    }
    .js [data-reveal].revealed {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
